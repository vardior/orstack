#!/usr/bin/env python3
import argparse
import os
import re
import subprocess
import sys
import time

EXIT_LINE = re.compile(r"^exit=(-?\d+)\s*$", re.MULTILINE)
STALLED = 3


def tail(path, lines=20):
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 8192))
        return "\n".join(f.read().decode("utf-8", "replace").splitlines()[-lines:])


def exit_code(path):
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 4096))
        matches = EXIT_LINE.findall(f.read().decode("utf-8", "replace"))
    return int(matches[-1]) if matches else None


def credential_helpers():
    listing = subprocess.run(["ps", "-axo", "pid,etime,command"], capture_output=True, text=True).stdout
    return [line.strip() for line in listing.splitlines()[1:]
            if any(os.path.basename(token).startswith("docker-credential-") for token in line.split()[2:4])]


def main():
    parser = argparse.ArgumentParser(
        description="Wait for a job's log to end with an exit=<code> line. Exits 0 when the job exited 0, 1 when it failed, "
        f"or {STALLED} once the job has run twice its expected time and the log has not grown for --quiet seconds.")
    parser.add_argument("log")
    parser.add_argument("expected_seconds", type=int)
    parser.add_argument("--quiet", type=int, default=300)
    parser.add_argument("--poll", type=int, default=15)
    args = parser.parse_args()

    started = time.time()
    while True:
        code = exit_code(args.log)
        if code is not None:
            print(f"exit={code} after {int(time.time() - started)}s")
            return 0 if code == 0 else 1
        now = time.time()
        modified = os.path.getmtime(args.log) if os.path.exists(args.log) else started
        if now - started > 2 * args.expected_seconds and now - modified > args.quiet:
            print(f"STALLED: running {int(now - started)}s, expected {args.expected_seconds}s, "
                  f"log unchanged for {int(now - modified)}s: {args.log}")
            if os.path.exists(args.log):
                print(tail(args.log))
            helpers = credential_helpers()
            if helpers:
                print("Docker credential helpers still running; an expired cloud CLI login hangs them. Report it to your lead, "
                      "or rerun a build that needs only public images with DOCKER_CONFIG pointing at a copy of "
                      "~/.docker/config.json without credHelpers:")
                print("\n".join(helpers))
            return STALLED
        time.sleep(args.poll)


if __name__ == "__main__":
    sys.exit(main())
